{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditaur.dev/schemas/drill-run.schema.json",
  "title": "Auditaur drill run",
  "description": "Run folder contract under `.auditaur/drill-runs/<runId>/`. `run.json` matches this schema (a snapshot; live readers then apply `events.jsonl` lines with a greater `seq`); `attempt.json` matches `#/$defs/attempt`; each `events.jsonl` line matches `#/$defs/event`.",
  "$ref": "#/$defs/run",
  "$defs": {
    "status": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "timedOut",
        "skipped",
        "interrupted"
      ]
    },
    "outcome": {
      "enum": [
        "expected",
        "unexpected",
        "flaky",
        "skipped"
      ]
    },
    "phase": {
      "enum": [
        "beforeAll",
        "beforeEach",
        "test",
        "afterEach",
        "afterAll"
      ]
    },
    "testId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "FNV-1a 64 of `<workspace-relative path>\\u0000<test name>`; stable across runs."
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 UTC."
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {},
        "actual": {}
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contentType",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "passed",
        "failed",
        "flaky",
        "skipped",
        "notRun"
      ],
      "properties": {
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "flaky": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "notRun": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attemptSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "status",
        "startedAt",
        "durationMs",
        "error",
        "dir"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "dir": {
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "title",
        "tags",
        "mode",
        "modeReason",
        "expectedStatus",
        "status",
        "outcome",
        "durationMs",
        "attempts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/testId"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "run",
            "only",
            "skip",
            "fixme"
          ]
        },
        "modeReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedStatus": {
          "$ref": "#/$defs/status"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attemptSummary"
          }
        }
      }
    },
    "suiteId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "FNV-1a 64 of the workspace-relative drill file path."
    },
    "relPath": {
      "type": "string",
      "pattern": "^[^/\\\\:]*[^/\\\\:.][^/\\\\:]*(/[^/\\\\:]*[^/\\\\:.][^/\\\\:]*)*$",
      "description": "Relative to the run folder: forward-slash segments, none empty, `.` or `..`, no `:`."
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suite",
        "path",
        "status",
        "startedAt",
        "durationMs",
        "app",
        "error",
        "hooks",
        "tests"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/suiteId"
        },
        "suite": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "startedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "app": {
          "description": "App session the suite ran against."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "hooks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        }
      }
    },
    "run": {
      "description": "`run.json`: the whole run, rewritten atomically as tests finish.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "status",
        "seq",
        "startedAt",
        "endedAt",
        "durationMs",
        "pid",
        "workspace",
        "invocation",
        "environment",
        "totals",
        "suites"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]{8}-[0-9]{6}-[0-9]{3}(-[0-9]{2})?$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Last events.jsonl seq reflected here; live readers apply later events."
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "description": "Owner of a running run; a dead owner means interrupted."
        },
        "workspace": {
          "type": "string"
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "args",
            "patterns",
            "grep",
            "grepInvert",
            "tags"
          ],
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "grep": {
              "type": [
                "string",
                "null"
              ]
            },
            "grepInvert": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch",
            "auditaurVersion"
          ],
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "auditaurVersion": {
              "type": "string"
            }
          }
        },
        "totals": {
          "$ref": "#/$defs/totals"
        },
        "suites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suite"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "phase",
        "title",
        "action",
        "status",
        "soft",
        "startedAt",
        "durationMs",
        "error",
        "attachments"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "title": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "soft": {
          "type": "boolean"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      }
    },
    "attempt": {
      "description": "`tests/<testId>/attempt-<n>/attempt.json`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "testId",
        "title",
        "attempt",
        "status",
        "startedAt",
        "durationMs",
        "error",
        "steps",
        "attachments"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "testId": {
          "$ref": "#/$defs/testId"
        },
        "title": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      }
    },
    "event": {
      "description": "One line of `events.jsonl`. Step, attachment and gate events with null testId belong to suite beforeAll/afterAll hooks.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "runId",
            "tests"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "runStarted"
            },
            "runId": {
              "type": "string"
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "suite",
            "path"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "suiteStarted"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "suite": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "app"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "suiteApp"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "app": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "title",
            "attempt"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "testStarted"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "$ref": "#/$defs/testId"
            },
            "title": {
              "type": "string"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "index",
            "phase",
            "title",
            "action"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "stepStarted"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/testId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "phase": {
              "$ref": "#/$defs/phase"
            },
            "title": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "index",
            "message"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "stepProgress"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/testId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "index",
            "status",
            "soft",
            "durationMs",
            "error"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "stepFinished"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/testId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "$ref": "#/$defs/status"
            },
            "soft": {
              "type": "boolean"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/error"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "step",
            "attachment"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "attachment"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/testId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "step": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "attachment": {
              "$ref": "#/$defs/attachment"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "step",
            "gate"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "gateWaiting"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/testId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "gate": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "step",
            "response"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "gateResolved"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/testId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "response": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "testId",
            "attempt",
            "status",
            "durationMs",
            "error",
            "willRetry",
            "outcome"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "testFinished"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
            },
            "testId": {
              "$ref": "#/$defs/testId"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "$ref": "#/$defs/status"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/error"
                },
                {
                  "type": "null"
                }
              ]
            },
            "willRetry": {
              "type": "boolean"
            },
            "outcome": {
              "anyOf": [
                {
                  "$ref": "#/$defs/outcome"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "ts",
            "type",
            "suiteId",
            "status",
            "durationMs",
            "error"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "ts": {
              "$ref": "#/$defs/timestamp"
            },
            "type": {
              "const": "suiteFinished"
            },
            "suiteId": {
              "$ref": "#/$defs/suiteId"
