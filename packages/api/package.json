{
  "name": "@auditaur/api",
  "version": "0.9.0",
  "description": "Frontend telemetry API for Auditaur-enabled Tauri apps.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethjuarez/auditaur.git",
    "directory": "packages/api"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tauri",
    "observability",
    "opentelemetry",
    "telemetry"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:bundles": "vitest run bundle-test",
    "test:node-import": "node scripts/smoke-node-import.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.0",
    "@emnapi/runtime": "^1.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "rolldown": "^1.2.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
